rules_version = '2';
// Cada persona solo lee y escribe sus respaldos (users/{uid}/backups/...). Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Cabecera del respaldo: { createdAt, appVersion, chunks }
    match /users/{uid}/backups/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'appVersion', 'chunks'])
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.chunks is number
        && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 120;
    }

    // Trozos del archivo cifrado: { data } de hasta 900 000 caracteres (lo que corta la app)
    match /users/{uid}/backups/{id}/chunks/{n} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && n.matches('^[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
